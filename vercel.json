{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/ai/[action].js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/((?!api/|assets/|data/).*)", "destination": "/index.html" }
  ]
}
